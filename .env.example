# Copie este arquivo para .env e ajuste os valores.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (MySQL). Para um teste rápido sem MySQL use DB_ENGINE=sqlite
DB_ENGINE=mysql
DB_NAME=danfe_painel
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Pasta onde ficam os PDFs das notas (DANFE). Caminho absoluto ou relativo ao projeto.
DANFE_PASTA=notas_pdf
# Importação automática: com 1, o "runserver" já sobe o monitor da pasta junto.
DANFE_MONITOR_AUTOSTART=1
# Intervalo (em segundos) entre as verificações da pasta.
DANFE_MONITOR_INTERVALO=30
